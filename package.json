{
	"name": "allenheath-sq",
	"version": "4.0.0-dev",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"postinstall": "husky",
		"test": "vitest --run",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"knip": "knip",
		"check": "yarn check-types && yarn lint && yarn knip && yarn build && echo PASS || echo FAIL",
		"bt": "yarn install && yarn check-types && yarn lint && yarn knip && yarn build && yarn test && echo PASS || echo FAIL"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-allenheath-sq.git"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss,yaml}": [
			"prettier --write"
		],
		"*.{mjs,ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"eventemitter3": "^5.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "~3.0.2",
		"@types/node": "^26.2.0",
		"eslint": "~10.9.0",
		"eslint-plugin-n": "~18.3.0",
		"husky": "^9.1.7",
		"knip": "^5.46.0",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"type-testing": "^0.2.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "~8.67.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "yarn@4.18.0"
}
